            hictk validate "$OUT"

            rm -f "$RAW" "$CHROMSIZES"

            echo "[INFO] Finished chromosome: $CHR"
        done

        echo
        echo "[INFO] Finished sample: $SAMPLE"

        touch "results/logs/extract_balance/Wild.done"
        
