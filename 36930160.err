        echo "[INFO] Sample: $SAMPLE"

        for CHR in Ghir_A01 Ghir_A02 Ghir_A03 Ghir_A04 Ghir_A05 Ghir_A06 Ghir_A07 Ghir_A08 Ghir_A09 Ghir_A10 Ghir_A11 Ghir_A12 Ghir_A13 Ghir_D01 Ghir_D02 Ghir_D03 Ghir_D04 Ghir_D05 Ghir_D06 Ghir_D07 Ghir_D08 Ghir_D09 Ghir_D10 Ghir_D11 Ghir_D12 Ghir_D13; do
            echo
            echo "[INFO] Processing chromosome: $CHR"

            BASE="${SAMPLE}__${CHR}"
            RAW="tmp/${BASE}.raw.cool"
            OUT="results/balanced/${SAMPLE}/${BASE}_iced.cool"
            CHROMSIZES=$(mktemp "tmp/${BASE}.XXXXXX.chrom.sizes")

            hictk dump "$URI" \
                --table chroms \
                | awk -v chr="$CHR" '$1 == chr' \
                > "$CHROMSIZES"

            if [ ! -s "$CHROMSIZES" ]; then
                echo "[ERROR] Chromosome $CHR not found in $URI"
                exit 1
            fi

            mkdir -p "results/raw/${SAMPLE}"

            hictk dump "$URI" \
                --range "$CHR" \
                --range2 "$CHR" \
                --join \
                --sorted \
            | hictk load - "$RAW" \
                --chrom-sizes "$CHROMSIZES" \
                --bin-size "$RESOLUTION" \
                --format bg2 \
                --assume-sorted \
                --threads 10 \
                --tmpdir "tmp" \
                --force

            cp "$RAW" "results/raw/${SAMPLE}/${BASE}.raw.cool"

            cp "$RAW" "$OUT"

            hictk balance ice "$OUT" \
                --tmpdir "tmp" \
                --threads 10 \
                --name weight \
                --force \
                --no-create-weight-link

            hictk validate "$OUT"

            rm -f "$RAW" "$CHROMSIZES"

            echo "[INFO] Finished chromosome: $CHR"
        done

