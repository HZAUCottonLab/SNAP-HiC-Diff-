            RAW="tmp/${BASE}.raw.cool"
            OUT="results/balanced/${SAMPLE}/${BASE}_iced.cool"
            CHROMSIZES=$(mktemp "tmp/${BASE}.XXXXXX.chrom.sizes")

            hictk dump "$URI" \
                --table chroms \
                | awk -v chr="$CHR" '$1 == chr' \
                > "$CHROMSIZES"

            if [ ! -s "$CHROMSIZES" ]; then
