#!/bin/bash
#DSUB -n H1398_L134_point_state
#DSUB -R 'cpu=2'
#DSUB -q arm
#DSUB -aa
#DSUB -o logs/cluster/H1398_L134_point_state_%J.out

set -euo pipefail

WORKDIR="/share/home/xhhuang24/project/PanTE/SNAP-HiC-Diff/.worktrees/is-tad-boundary-annotation"
SHARED_CONDA_PREFIX="/share/home/xhhuang24/project/PanTE/SNAP-HiC-Diff/.snakemake/conda"
COMPARISON="H1398_vs_L134"
LOCUS_ROOT="results/multiscale/r4000/$COMPARISON/is_change"

cd "$WORKDIR"
mkdir -p results/audits logs/cluster
AUDIT_DIR="$(mktemp -d results/audits/H1398_L134_point_state_$(date +%Y%m%d).XXXXXX)"
printf 'Audit directory: %s/%s\n' "$WORKDIR" "$AUDIT_DIR"

tar -czf "$AUDIT_DIR/previous_results.tar.gz" \
    results/tad_boundaries/H1398.multires.unified.boundaries.tsv \
    results/tad_boundaries/L134.multires.unified.boundaries.tsv \
    results/tad_boundary_events/H1398_vs_L134.boundary_events.tsv \
    results/tad_boundary_events/H1398_vs_L134.matching_qc.tsv \
    results/tad_boundary_events/H1398_vs_L134.annotation_qc.tsv \
    results/tad_boundary_events/H1398_vs_L134.annotation_summary.tsv \
    "$LOCUS_ROOT/H1398_vs_L134_is_change_loci.boundary_annotated.tsv" \
    "$LOCUS_ROOT/H1398_vs_L134_is_change_loci_preliminary.boundary_annotated.tsv" 2>/dev/null || true
cp -p config/config.yaml "$AUDIT_DIR/config.yaml"
sha256sum scripts/is_boundary_point_state.py scripts/is_boundary_annotation.py \
    scripts/annotate_is_change_boundaries.py scripts/is_boundary_unification.py \
    > "$AUDIT_DIR/code.sha256"

export CONDA_OFFLINE=true
export CONDA_ENVS_PATH="$SHARED_CONDA_PREFIX"
CONDA_PREFIX_DIR="$SHARED_CONDA_PREFIX" bash scripts/conda_envs.sh verify

snakemake \
    --executor cluster-generic \
    --use-conda \
    --conda-prefix "$SHARED_CONDA_PREFIX" \
    -j 4 \
    --configfile config/config.yaml \
    --rerun-incomplete \
    --rerun-triggers mtime \
    --latency-wait 180 \
    --cluster-generic-submit-cmd "bash config/dsub_submit.sh {threads} {rulename}" \
    --cluster-generic-status-cmd "bash config/dsub_status.sh" \
    --cluster-generic-cancel-cmd dkill \
    --cluster-generic-cancel-nargs 1 \
    --allowed-rules unify_tad_boundaries call_tad_boundary_events annotate_is_change_boundaries \
    --forcerun unify_tad_boundaries call_tad_boundary_events annotate_is_change_boundaries \
    -- \
    "$LOCUS_ROOT/H1398_vs_L134_is_change_loci.boundary_annotated.tsv" \
    "results/tad_boundary_events/$COMPARISON.boundary_point_map.tsv"

cp -p results/tad_boundary_events/H1398_vs_L134.{matching_qc,annotation_qc,annotation_summary}.tsv "$AUDIT_DIR/" 2>/dev/null || true
printf 'point-state annotation rerun completed. Audit: %s/%s\n' "$WORKDIR" "$AUDIT_DIR"
